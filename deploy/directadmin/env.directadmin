# Nebo Stage settings for shared hosting. index.php copies this to .env on the
# first visit (adding a fresh APP_KEY); the web installer fills in the rest.
APP_NAME="Nebo Stage"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

NEBO_DISPLAY_TIMEZONE=Africa/Lagos

# The browser installer (/install). It switches itself off when finished
# (storage/app/installed.lock); delete that file only to reinstall.
NEBO_INSTALLER=true

# No cron needed: daily jobs and queued emails run after page visits. A cron
# job running `php artisan schedule:run` every minute also works (optional).
NEBO_WEB_CRON=true
